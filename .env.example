# Copie este arquivo para  .env  e preencha a SENHA.
# O .env NUNCA vai para o Git (está no .gitignore).

FTP_HOST="187.108.194.90"
FTP_USUARIO="contemmagia"
FTP_SENHA="COLE_A_SENHA_AQUI"

# Pasta raiz no servidor. Cada página vira uma subpasta com o nome da slug:
#   coe/  →  /public_html/coe/  →  https://contemmagia.com.br/coe
FTP_BASE="/public_html/"

# Cloudflare (opcional): limpa o cache ao publicar -> mudança instantânea.
# Token precisa da permissão "Cache Purge". Sem isso, a mudança leva até 10 min.
CF_API_TOKEN=""
CF_ZONE_ID="4b373e90f828abc33b2cc1b315042109"
