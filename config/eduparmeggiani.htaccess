# BEGIN CM migration eduparmeggiani.com
# Insert before the existing WordPress block in public_html/.htaccess.
# The same published static files serve both domains; no duplicate page uploads.
<IfModule mod_rewrite.c>
RewriteEngine On

# Keep certificate validation reachable when the domain moves to this server.
RewriteCond %{HTTP_HOST} ^(?:www\.)?eduparmeggiani\.com(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^\.well-known/(?:acme-challenge|pki-validation)/ - [L]

# Old pages confirmed in the WordPress sitemap. Query strings are retained.
# Never change POST requests into GET redirects.
RewriteCond %{HTTP_HOST} ^(?:www\.)?eduparmeggiani\.com(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^(iat|t3x|wmpp-obrigado|bpa|6-edb|6-edb-obrigado|drb-vsl)/?$ https://lp.eduparmeggiani.com/$1/ [R=302,L]

RewriteCond %{HTTP_HOST} ^(?:www\.)?eduparmeggiani\.com(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^$ https://lp.eduparmeggiani.com/ [R=302,L]

# Missing assets must return 404, not the unrelated WordPress in this root.
RewriteCond %{HTTP_HOST} ^(?:www\.)?eduparmeggiani\.com(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?:bce|coe|drb|mce|mpg|gdp|ecm-26|ecm-26-v1|mpp|bco)(?:/|$) - [R=404,L]

RewriteCond %{HTTP_HOST} ^(?:www\.)?eduparmeggiani\.com(?::[0-9]+)?$ [NC]
RewriteRule ^(?:bce|coe|drb|mce|mpg|gdp|ecm-26|ecm-26-v1|mpp|bco)(?:/|$) - [L]

# Any route outside the explicit migration map stays a real 404.
RewriteCond %{HTTP_HOST} ^(?:www\.)?eduparmeggiani\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ - [R=404,L]
</IfModule>
# END CM migration eduparmeggiani.com

RewriteCond %{HTTP_HOST} ^contemmagia\.com\.br$ [OR]
RewriteCond %{HTTP_HOST} ^www\.contemmagia\.com\.br$
RewriteRule ^p\-trilha\-da\-benzedeira\/?(.*)$ "https\:\/\/vembenzer\.com\.br\/p\-trilha\-da\-benzedeira$1" [R=301,L]

# BEGIN WordPress
# As diretrizes (linhas) entre "BEGIN WordPress" e "END WordPress" são
# geradas dinamicamente e só devem ser modificadas através de filtros do WordPress.
# Quaisquer alterações nas diretivas entre esses marcadores serão sobrescritas.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# BEGIN HttpHeaders
# As diretrizes (linhas) entre "BEGIN HttpHeaders" e "END HttpHeaders" são
# geradas dinamicamente e só devem ser modificadas através de filtros do WordPress.
# Quaisquer alterações nas diretivas entre esses marcadores serão sobrescritas.
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html)$">
    Header set X-Frame-Options "ALLOW-FROM https://clkdmg.site"
    Header set Content-Security-Policy "frame-ancestors 'self'; frame-src 'self' https://clkdmg.site https://www.facebook.com"
  </FilesMatch>
</IfModule>
# END HttpHeaders
